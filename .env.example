# Anthropic (Claude) - first choice for every chat step; Groq / OpenRouter take over automatically
# when it has no balance, a bad key or a limit. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# PIN that unlocks Staff mode in the sidebar (teach rules, look up customers by name).
# Leave empty to keep the app customer-only.
STAFF_PIN=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# QUOTE_AGENT_STORAGE_STORAGE=storage

# Optional fallback provider (used automatically when Groq hits a limit or is down).
# Only free OpenRouter models are used unless settings.json allows paid ones.
OPENROUTER_API_KEY=

# Optional free fallback LLM provider (Cloudflare Workers AI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Reads uploaded PDFs / images
GEMINI_API_KEY=

# Unlocks the encrypted product catalog data/catalog.db.enc (deployments without data/catalog.db)
PRICE_SHEET_KEY=
